# Environment Configuration for WarEvents

# AWS Deployment
AWS_REGION=eu-west-1
AWS_INSTANCE_ID=i-xxxxx
AWS_SECURITY_GROUP=sg-xxxxx

# Telegram API (for telegram_fetch.py)
TG_API_ID=123456789
TG_API_HASH=abcdef123456

# Weather API (for weather_forecast.py)
WEATHER_API_KEY=your-visual-crossing-api-key

# Database / Storage (optional)
DATABASE_URL=postgresql://user:pass@localhost/warevents
S3_BUCKET=warevents-predictions

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_KEY=your-secret-api-key
API_DEBUG=false

# Model Configuration
MODEL_VERSION=v1_binary
MODEL_PATH=/home/ec2-user/WarEvents/src/forecast_pipeline
PREDICTIONS_PATH=/home/ec2-user/WarEvents/data/predictions

# Logging
LOG_LEVEL=INFO
LOG_DIR=/home/ec2-user/WarEvents/data/logs

# Features Path
FEATURES_PATH=/home/ec2-user/WarEvents/data/final/FINAL_FEATURES_24H.csv
ISW_HISTORY_PATH=/home/ec2-user/WarEvents/data/isw/isw_history.json
TELEGRAM_FEATURES_PATH=/home/ec2-user/WarEvents/data/telegram/telegram_features_24h.csv
ALARMS_FEATURES_PATH=/home/ec2-user/WarEvents/data/alarms/alarms_features_hourly.csv
WEATHER_FEATURES_PATH=/home/ec2-user/WarEvents/data/weather/weather_features_hourly.csv
